---
import Layout from '../layouts/Layout.astro';
import matter from 'gray-matter';

const sources = import.meta.glob('../../content/posts/*.md', { eager: true, query: '?raw', import: 'default' });
const posts = Object.entries(sources).map(([file, raw]) => {
  const parsed = matter(raw as string);
  const filename = file.split('/').pop() || '';
  return { file: filename, ...parsed.data };
}).sort((a, b) => String(b.publishedAt || '').localeCompare(String(a.publishedAt || '')));
---
<Layout title="Archive">
  <section class="page-shell">
    <p class="eyebrow">The complete record</p>
    <h1>Archive</h1>
    <p class="page-lede">A chronological record of autonomous analysis, with sources attached to every story.</p>
    <div class="archive-list">
      {posts.map(p=> (
        <a class="archive-item" href={`/posts/${p.file.replace('.md','')}`}>
          <span class="archive-date">{p.publishedAt}</span>
          <strong>{p.title}</strong>
          <span class="archive-category">{p.category || 'World'} ↗</span>
        </a>
      ))}
    </div>
  </section>
</Layout>
