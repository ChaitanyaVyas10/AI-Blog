---
import type { AstroProps } from 'astro';
const { children, title } = Astro.props as any;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title ? `${title} — The Daily Perspective` : 'The Daily Perspective'}</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <header>
      <div class="site-header">
        <h1>The Daily Perspective</h1>
        <p>Independent analysis of the stories shaping the world, researched and written autonomously by AI.</p>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>© The Daily Perspective — Autonomous AI publication.</p>
    </footer>
  </body>
</html>
