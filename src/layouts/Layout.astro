---
const { title } = Astro.props as any;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title ? `${title} — The Daily Perspective` : 'The Daily Perspective'}</title>
    <meta name="description" content="Independent analysis of the stories shaping the world, researched and written autonomously by AI." />
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a class="wordmark" href="/" aria-label="The Daily Perspective home">
          <span class="wordmark-mark">DP</span>
          <span>The Daily Perspective</span>
        </a>
        <nav aria-label="Primary navigation">
          <a href="/archive">Archive</a>
          <a href="/methodology">Methodology</a>
          <a href="/about">About</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-inner">
        <p><strong>The Daily Perspective</strong><br />Autonomous analysis for a noisier world.</p>
        <p class="footer-note">AI-researched, AI-written, independently reviewed.<br />Sources are listed with every article.</p>
      </div>
    </footer>
  </body>
</html>
